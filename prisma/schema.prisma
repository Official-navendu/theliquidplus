// BUSINESS MODULES - SETTINGS
// ==============================================================================

model GeneralSetting {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeName    String  @map("store_name")
  contactEmail String  @map("contact_email")
  contactPhone String? @map("contact_phone")

  @@map("general_settings")
}

model ThemeSetting {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  primaryColor String  @map("primary_color")
  fontFamily   String  @map("font_family")
  logoUrl      String? @map("logo_url")

  @@map("theme_settings")
}

model PaymentSetting {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  razorpayEnabled Boolean @default(true) @map("razorpay_enabled")
  stripeEnabled   Boolean @default(false) @map("stripe_enabled")
  codEnabled      Boolean @default(true) @map("cod_enabled")

  @@map("payment_settings")
}

model ShippingSetting {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  freeShippingThreshold Decimal? @map("free_shipping_threshold") @db.Decimal(12, 2)
  flatRate              Decimal? @map("flat_rate") @db.Decimal(12, 2)

  @@map("shipping_settings")
}

model TaxRule {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  rate      Decimal  @db.Decimal(5, 2)
  country   String
  state     String?
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  orderItems OrderItem[]

  @@map("tax_rules")
}

model EmailSetting {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fromEmail String  @map("from_email")
  smtpHost  String? @map("smtp_host")
  smtpPort  Int?    @map("smtp_port")

  @@map("email_settings")
}

model SeoSetting {
  id                 String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  defaultTitle       String @map("default_title")
  defaultDescription String @map("default_description")

  @@map("seo_settings")
}

model FeatureFlag {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String            @unique
  status      FeatureFlagStatus @default(DISABLED)
  description String?
  createdAt   DateTime          @default(now()) @map("created_at")

  @@map("feature_flags")
}

// ==============================================================================
// BUSINESS MODULES - ANALYTICS
// ==============================================================================

model PageView {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  path      String
  userId    String?  @map("user_id") @db.Uuid
  sessionId String?  @map("session_id")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([path])
  @@map("page_views")
}

model ProductView {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  sessionId String?  @map("session_id")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@map("product_views")
}

model SearchLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  query        String
  userId       String?  @map("user_id") @db.Uuid
  resultsCount Int      @map("results_count")
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([query])
  @@map("search_logs")
}

model SalesAnalytics {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date              DateTime @unique
  totalSales        Decimal  @map("total_sales") @db.Decimal(12, 2)
  ordersCount       Int      @map("orders_count")
  averageOrderValue Decimal  @map("average_order_value") @db.Decimal(12, 2)
  createdAt         DateTime @default(now()) @map("created_at")

  @@map("sales_analytics")
}

model TrafficAnalytics {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date                DateTime @unique
  pageViewsCount      Int      @map("page_views_count")
  uniqueVisitorsCount Int      @map("unique_visitors_count")
  createdAt           DateTime @default(now()) @map("created_at")

  @@map("traffic_analytics")
}

model DashboardMetric {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  metricKey   String   @unique @map("metric_key")
  metricValue String   @map("metric_value")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("dashboard_metrics")
}

// ==============================================================================
// BUSINESS MODULES - AUDIT & SYSTEM
// ==============================================================================

model SystemLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  level     String
  message   String   @db.Text
  context   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("system_logs")
}

model ErrorLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  message    String   @db.Text
  stackTrace String?  @map("stack_trace") @db.Text
  path       String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("error_logs")
}

model WebhookLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider     String
  event        String
  payload      Json
  responseCode Int?     @map("response_code")
  errorMessage String?  @map("error_message") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("webhook_logs")
}

model ApiKey {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  keyHash    String    @unique @map("key_hash")
  name       String
  isReadOnly Boolean   @default(true) @map("is_read_only")
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime? @map("expires_at")

  @@map("api_keys")
}

model ScheduledJob {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String    @unique
  cronExpression String    @map("cron_expression")
  lastRunAt      DateTime? @map("last_run_at")
  nextRunAt      DateTime? @map("next_run_at")
  isActive       Boolean   @default(true) @map("is_active")

  @@map("scheduled_jobs")
}

model BackgroundJob {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  payload      Json?
  status       JobStatus @default(PENDING)
  errorMessage String?   @map("error_message") @db.Text
  createdAt    DateTime  @default(now()) @map("created_at")
  startedAt    DateTime? @map("started_at")
  completedAt  DateTime? @map("completed_at")

  @@map("background_jobs")
}
